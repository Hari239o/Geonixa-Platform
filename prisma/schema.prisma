generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  role      String   @default("user") // "creator", "brand", "partner", "user"
  profileCompleted Boolean @default(false)
  credits   Int      @default(0) // Default 0 credits
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  campaigns      Campaign[]
  unlockedProfiles UnlockedProfile[]
}

model CreatorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName        String?
  bio             String?
  profilePic      String?
  category        String?
  tags            String[] @default([])
  followers       String   @default("0")
  viewership      String   @default("0")
  engagement      String   @default("0")
  projects        String   @default("0")
  successRate     String   @default("0%")
  portfolioImages String[] @default([])
  isVerified      Boolean  @default(false)
  
  website         String?
  phone           String?
  facebook        String?
  instagram       String?
  x               String?
  linkedin        String?
  budgets         Json?
  teamMembers     String?
  brandType       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id              String   @id @default(uuid())
  userId          String   // Brand that created the campaign
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String
  subtitle        String?
  budget          String?
  dateRange       String?
  description     String?
  daysLeft        String?
  category        String?
  tags            String[] @default([])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BrandProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName        String?  // Company Name or Individual Name
  bio             String?
  profilePic      String?
  category        String?
  website         String?
  phone           String?
  facebook        String?
  instagram       String?
  x               String?
  linkedin        String?
  teamMembers     String?
  brandType       String?  // company or individual
  portfolioImages String[] @default([])
  isVerified      Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UnlockedProfile {
  id              String   @id @default(uuid())
  brandId         String   // The brand that unlocked
  user            User     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  creatorId       String   // The creator who was unlocked
  unlockType      String   // "once", "lifelong"
  createdAt       DateTime @default(now())

  @@unique([brandId, creatorId, unlockType])
}
