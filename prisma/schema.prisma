generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  password  String?
  resetToken String?
  resetTokenExpiry DateTime?
  name      String?
  role      String   @default("user") // "creator", "brand", "partner", "user"
  profileCompleted Boolean @default(false)
  credits   Int      @default(0) // Default 0 credits
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
  campaigns      Campaign[]
  unlockedProfiles UnlockedProfile[]
  notifications  Notification[]
}

model CreatorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName        String?
  bio             String?
  profilePic      String?
  category        String?
  tags            String[] @default([])
  followers       String   @default("0")
  viewership      String   @default("0")
  engagement      String   @default("0")
  projects        String   @default("0")
  successRate     String   @default("0%")
  portfolioImages String[] @default([])
  isVerified      Boolean  @default(false)
  
  website         String?
  phone           String?
  facebook        String?
  instagram       String?
  x               String?
  linkedin        String?
  budgets         Json?
  teamMembers     String?
  brandType       String?
  
  campaignRequests CampaignRequest[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  campaignInvites CampaignInvite[]
}

model Campaign {
  id              String   @id @default(uuid())
  userId          String   // Brand that created the campaign
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String
  subtitle        String?
  budget          String?
  dateRange       String?
  description     String?
  daysLeft        String?
  category        String?
  tags            String[] @default([])
  visibility      String   @default("Public")
  invitedCreators String[] @default([])
  
  requests        CampaignRequest[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  campaignInvites CampaignInvite[]
}

model CampaignRequest {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status          String   @default("pending") // "accepted", "rejected", "negotiating"
  message         String?  // Optional negotiation message
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, creatorId])
}

model BrandProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName        String?  // Company Name or Individual Name
  bio             String?
  profilePic      String?
  category        String?
  website         String?
  phone           String?
  facebook        String?
  instagram       String?
  x               String?
  linkedin        String?
  teamMembers     String?
  brandType       String?  // company or individual
  portfolioImages String[] @default([])
  isVerified      Boolean  @default(false)
  
  registrationNumber String?
  registrationDoc    String?
  panNumber          String?
  panDoc             String?
  gstNumber          String?
  gstDoc             String?
  authorizedPerson   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  campaignInvites CampaignInvite[]
}

model UnlockedProfile {
  id              String   @id @default(uuid())
  brandId         String   // The brand that unlocked
  user            User     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  creatorId       String   // The creator who was unlocked
  unlockType      String   // "once", "lifelong"
  createdAt       DateTime @default(now())

  @@unique([brandId, creatorId, unlockType])
}

model CampaignInvite {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  creatorId       String
  creator         CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  brandId         String
  brand           BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, NEGOTIATING, BRAND_ACCEPTED_NEGOTIATION, BRAND_REJECTED_NEGOTIATION
  negotiatedPrice String?  // Price proposed by the creator during negotiation
  message         String?  // Optional message from creator
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([campaignId, creatorId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  actionUrl   String?
  actionLabel String?
  senderImage String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model DealChat {
  id        String   @id @default(uuid())
  dealId    String   // Reference to the campaign request or invite
  brandId   String
  creatorId String
  status    String   @default("bot") // "bot", "admin_joined", "resolved"
  
  messages  ChatMessage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  chatId     String
  chat       DealChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  senderId   String   // "bot", "admin", or userId
  senderName String
  content    String
  
  createdAt  DateTime @default(now())
}

